# Normalize line endings to LF everywhere
* text=auto eol=lf

# Windows-specific scripts stay CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Rust source
*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Binary files — never diff or mangle
*.gguf        binary
*.bin         binary
*.safetensors binary
*.pt          binary
*.pth         binary
*.so          binary
*.dylib       binary
*.dll         binary
*.exe         binary
*.pdb         binary
